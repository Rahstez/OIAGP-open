{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oiagp.example/v0.1/schemas/principal.schema.json",
  "title": "OIAGP Principal",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal_id", "principal_type", "institution_id", "status", "authentication_methods"],
  "properties": {
    "principal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "principal_type": {"enum": ["human", "service", "agent", "workload", "institution"]},
    "institution_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "status": {"enum": ["active", "suspended", "revoked"]},
    "authentication_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
    "display_name": {"type": "string", "maxLength": 256},
    "metadata": {"type": "object", "maxProperties": 50}
  }
}
