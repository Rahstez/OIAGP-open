{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oiagp.example/v0.1/schemas/capability-declaration.schema.json",
  "title": "OIAGP Capability Declaration",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["oiagp_version", "message_type", "message_id", "issued_at", "provider", "capability", "operations", "side_effect_class", "interruption_supported"],
      "properties": {
        "oiagp_version": {"$ref": "common.schema.json#/$defs/version"},
        "message_type": {"const": "capability_declaration"},
        "message_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "correlation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "extensions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/extension"}},
        "provider": {"$ref": "common.schema.json#/$defs/identifier"},
        "capability": {"$ref": "common.schema.json#/$defs/identifier"},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
        "input_media_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "output_media_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "side_effect_class": {"enum": ["none", "reversible", "consequential", "irreversible", "unknown"]},
        "approval_class": {"type": "string", "maxLength": 128},
        "data_classifications": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "interruption_supported": {"type": "boolean"}
      }
    }
  ]
}
