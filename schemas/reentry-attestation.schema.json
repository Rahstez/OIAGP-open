{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oiagp.example/v0.1/schemas/reentry-attestation.schema.json",
  "title": "OIAGP Re-entry Attestation",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["oiagp_version","message_type","message_id","issued_at","attestation_id","principal_id","agent_id","trigger","controlling_posture","authority_state","source_state","decision","proof"],
      "properties": {
        "oiagp_version": {"$ref": "common.schema.json#/$defs/version"},
        "message_type": {"const": "reentry_attestation"},
        "message_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "correlation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "extensions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/extension"}},
        "attestation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "principal_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "agent_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "tenant_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "trigger": {"enum": ["new_governed_conversation","session_restart","model_handoff","context_reconstruction","material_domain_transition","drift_detected","manual_recheck"]},
        "controlling_posture": {
          "type": "object", "additionalProperties": false,
          "required": ["source_id","version_or_digest","release_state","verified"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1, "maxLength": 512},
            "version_or_digest": {"type": "string", "minLength": 1, "maxLength": 256},
            "release_state": {"enum": ["active","released","superseded","unknown"]},
            "verified": {"type": "boolean"}
          }
        },
        "authority_state": {
          "type": "object", "additionalProperties": false,
          "required": ["status","checked_at"],
          "properties": {
            "status": {"enum": ["current","expired","revoked","missing","contradictory","not_required"]},
            "grant_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "checked_at": {"$ref": "common.schema.json#/$defs/timestamp"}
          }
        },
        "source_state": {
          "type": "object", "additionalProperties": false,
          "required": ["controlled_sources_available","source_priority_enforced","contradiction_state"],
          "properties": {
            "controlled_sources_available": {"type": "boolean"},
            "source_priority_enforced": {"type": "boolean"},
            "contradiction_state": {"enum": ["none","resolved","unresolved"]}
          }
        },
        "decision": {"enum": ["aligned","fail_closed","principal_required"]},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true},
        "proof": {"$ref": "common.schema.json#/$defs/proof"}
      }
    }
  ]
}
