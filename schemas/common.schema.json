{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oiagp.example/v0.1/schemas/common.schema.json",
  "title": "OIAGP Common Types",
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "version": {"type": "string", "pattern": "^0\\.1(?:\\.[0-9]+)?(?:-[A-Za-z0-9.-]+)?$"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key_id", "created", "value"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "key_id": {"$ref": "#/$defs/identifier"},
        "created": {"$ref": "#/$defs/timestamp"},
        "algorithm": {"type": "string", "minLength": 1, "maxLength": 64},
        "value": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "required", "value"],
      "properties": {
        "namespace": {"type": "string", "format": "uri"},
        "required": {"type": "boolean"},
        "schema": {"type": "string", "format": "uri"},
        "value": {}
      }
    },
    "resource_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifiers"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "identifiers": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "constraints": {"type": "object", "maxProperties": 100}
      }
    },
    "envelope": {
      "type": "object",
      "required": ["oiagp_version", "message_type", "message_id", "issued_at"],
      "properties": {
        "oiagp_version": {"$ref": "#/$defs/version"},
        "message_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "message_id": {"$ref": "#/$defs/identifier"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "correlation_id": {"$ref": "#/$defs/identifier"},
        "extensions": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/extension"}}
      }
    }
  }
}
