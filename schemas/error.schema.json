{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oiagp.example/v0.1/schemas/error.schema.json",
  "title": "OIAGP Error",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["oiagp_version", "message_type", "message_id", "issued_at", "error_code", "correlation_id", "retryable"],
      "properties": {
        "oiagp_version": {"$ref": "common.schema.json#/$defs/version"},
        "message_type": {"const": "error"},
        "message_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "correlation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "extensions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/extension"}},
        "error_code": {"enum": ["AUTHENTICATION_REQUIRED", "AUTHORITY_MISSING", "AUTHORITY_INVALID", "AUTHORITY_EXPIRED", "AUTHORITY_REVOKED", "TENANT_MISMATCH", "CAPABILITY_UNAVAILABLE", "OPERATION_NOT_ALLOWED", "APPROVAL_REQUIRED", "REPLAY_DETECTED", "RESOURCE_OUT_OF_SCOPE", "INTERRUPTION_REJECTED", "VERSION_UNSUPPORTED", "POLICY_UNAVAILABLE", "OUTCOME_INDETERMINATE", "INVALID_ENVELOPE"]},
        "message": {"type": "string", "maxLength": 1024},
        "retryable": {"type": "boolean"},
        "retry_after_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    }
  ]
}
